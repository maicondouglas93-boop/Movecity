NODE_ENV=
PORT=3000
FRONTEND_URL=
ADMIN_FRONTEND_URL=
DB_CONNECT=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
ADMIN_COOKIE_PASSWORD=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET não é mais usado (2026-08-03): o bucket do Storage nunca
# existiu de verdade neste projeto Firebase (plano Spark não provisiona bucket padrão
# sozinho — só o Blaze). Upload de imagem migrou pro ImageKit (ver abaixo). As demais
# variáveis do Firebase continuam em uso (Auth, Cloud Messaging/push).

# ImageKit (upload de foto de perfil, veículo e documentos do motorista) — dashboard
# em imagekit.io. Nunca commitar a PRIVATE_KEY.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# URL pública do backend (ex: https://movecity-api.onrender.com). Usada pelo Service
# Worker do app do motorista pra montar a chamada de "Aceitar corrida" quando o app está
# fechado (notification.service.js: sendNewRide anexa isto ao payload como data.apiUrl).
# Sem isso configurado em produção, o Service Worker tenta aceitar a corrida contra o
# próprio dispositivo do motorista e a ação sempre falha silenciosamente.
BASE_URL=

# Central de Ajuda do passageiro (GET /support/contact). WhatsApp em E.164 sem +
# (ex: 5511999999999). E-mail de atendimento ao cliente.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# Por quanto tempo (minutos) um motorista continua disponível para receber corridas
# depois do último contato real com o servidor (abrir o app, atualizar localização ou
# tocar em "Ficar Online"). Separa disponibilidade de conexão: fechar o app não tira
# mais o motorista do despacho na hora — é isso que permite a notificação push de
# corrida nova chegar a quem está com o app fechado. Passado esse tempo sem nenhum
# sinal, ele sai do despacho até reabrir o app. Padrão: 15.
# Ver docs/plans/2026-08-03-disponibilidade-vs-conexao-motorista.md
CAPTAIN_AVAILABILITY_TTL_MINUTES=15

# Google Maps Platform — chave de SERVIDOR (Geocoding, Places, Routes API).
# Restringir no Console por IP do servidor + apenas essas 3 APIs. NUNCA usar
# esta mesma chave no frontend (ela não tem restrição de referrer HTTP).
GOOGLE_MAPS_API=

# Provider ativo em services/maps/index.js. "osm" = comportamento atual (Nominatim/OSRM,
# com fallback interno para Google se GOOGLE_MAPS_API for uma chave real). "google" ainda
# não está implementado (chega na Etapa 3 da migração) — setar antes disso derruba o boot.
MAPS_PROVIDER=osm

# --- Monitoramento de serviços externos (Painel Admin → /monitoring) ---
# Todas as consultas rodam no backend; chaves NUNCA vão para o frontend.
# Opcionais: sem elas o dashboard usa instrumentação interna + último snapshot em cache.

# MongoDB Atlas Admin API (digest auth) — métricas de cluster/backup
# MONGODB_ATLAS_PUBLIC_KEY=
# MONGODB_ATLAS_PRIVATE_KEY=
# MONGODB_ATLAS_GROUP_ID=
# MONGODB_ATLAS_CLUSTER_NAME=
# MONGODB_ATLAS_TIER=M0
# MONGODB_STORAGE_LIMIT_BYTES=536870912
# MONGODB_CONNECTIONS_LIMIT=500

# Render API — status do serviço, deploys
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# RENDER_PLAN=free
# APP_VERSION=

# Limites free estimados do Google Maps (requisições/mês por SKU) — ajustáveis
# GMAPS_FREE_GEOCODING=40000
# GMAPS_FREE_REVERSE_GEOCODING=40000
# GMAPS_FREE_PLACES_AUTOCOMPLETE=70000
# GMAPS_FREE_PLACE_DETAILS=40000
# GMAPS_FREE_ROUTES=40000
# GMAPS_FREE_MAPS_JS=28000

# Limites free ImageKit (bytes)
# IMAGEKIT_FREE_STORAGE_BYTES=21474836480
# IMAGEKIT_FREE_BANDWIDTH_BYTES=21474836480
# IMAGEKIT_PLAN=Free

# Token de autenticação do webhook do Asaas (configurado no painel Asaas ao criar o
# webhook, enviado de volta no header "asaas-access-token" em toda notificação). Sem
# isso configurado, POST /webhooks/asaas rejeita toda requisição — não confiar em
# nenhum payload de pagamento sem essa verificação.
ASAAS_WEBHOOK_TOKEN=
