# Variáveis de Ambiente do Frontend Administrativo (Vite)
# Essas variáveis precisam ser cadastradas nas "Environment Variables" da Vercel

# URL Base da sua API Backend (Produção)
# IMPORTANTE: Para o Vite ler a variável no React, ela OBRIGATORIAMENTE precisa começar com "VITE_"
VITE_API_URL=https://movecity.onrender.com/api

# (Opcional) URL do Socket.IO. Por padrão o painel deriva a ORIGIN de VITE_API_URL
# (sem o /api) — ex: https://movecity.onrender.com. Só preencha se o socket rodar em
# outro host/porta que a API REST.
# VITE_SOCKET_URL=https://movecity.onrender.com

# (Opcional) Ambiente
VITE_ENV=production

# (Opcional) Observabilidade — DSN do projeto no Sentry. Vazio = desligado.
VITE_SENTRY_DSN=
# (Opcional) Fração de transações com tracing (0 a 1). Default no código: 0.1.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Fase 7 da correção do sistema de push (2026-08-02): canal de push para o painel
# administrativo. Mesmo projeto Firebase usado pelo app do passageiro/motorista — só a
# VAPID key é obrigatória pra gerar token (sem ela, requestAdminFCMToken() simplesmente
# não gera token, sem quebrar o resto do painel).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
