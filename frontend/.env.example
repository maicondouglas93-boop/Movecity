# Variáveis de Ambiente do app passageiro/motorista (Vite)
# Copie para .env (dev local) e cadastre nas Environment Variables da Vercel (deploy).
# Para o Vite expor a variável ao React ela PRECISA começar com "VITE_".
# Fase 2 da auditoria de production readiness (H2, 2026-08-05): arquivo completo e
# versionado (o .gitignore tem exceção explícita para ele). Sem valores reais aqui.

# --- Backend (obrigatória) ---
# URL pública da API, SEM barra no final e SEM /api (as rotas ficam em /rides, /users...)
VITE_BASE_URL=http://localhost:3000

# --- Firebase (push + login com Google) ---
# Valores em: Firebase Console > Configurações do projeto > Geral > Seus apps.
# Sem eles o push E o "Entrar com o Google" não funcionam.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional — só Analytics.
VITE_FIREBASE_MEASUREMENT_ID=
# Obrigatória para gerar token de push (Firebase Console > Cloud Messaging >
# Web Push certificates). Sem ela o app não recebe notificação — sem erro visível.
VITE_FIREBASE_VAPID_KEY=

# --- Mapas ---
# 'leaflet' (default, sem chave) ou 'google'.
VITE_MAPS_PROVIDER=leaflet
# Obrigatória se VITE_MAPS_PROVIDER=google. NÃO use a API key do Firebase aqui.
VITE_GOOGLE_MAPS_API_KEY=
# Opcional — Map ID VETORIAL para a câmera de navegação (heading/tilt).
VITE_GOOGLE_MAPS_MAP_ID=

# --- Observabilidade (opcional) ---
# DSN do projeto no Sentry. Vazio = monitoramento desligado.
VITE_SENTRY_DSN=
# Fração de transações com tracing (0 a 1). Default no código: 0.1.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# --- Suporte (opcional — fallback quando GET /support/contact falha) ---
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=

# --- Build do motorista ---
# NÃO defina VITE_APP_ROLE aqui: ela é injetada pelo modo de build
# (npm run build:driver usa --mode driver, que lê .env.driver).
# Canal de distribuição: use "play" no AAB da Play Store. Vazio mantém o
# atualizador próprio de APK usado na distribuição externa do motorista.
VITE_DISTRIBUTION_CHANNEL=
