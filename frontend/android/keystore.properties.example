# Copie para keystore.properties (NÃO commitar) e preencha.
# Gerar keystore (uma vez):
#   keytool -genkey -v -keystore movecity-driver-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias movecity
#
# GitHub Actions (Release por TAG) usa Secrets — ver docs/ANDROID_RELEASE.md:
#   ANDROID_KEYSTORE_BASE64
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
#
storeFile=movecity-driver-release.jks
storePassword=CHANGE_ME
keyAlias=movecity
keyPassword=CHANGE_ME
