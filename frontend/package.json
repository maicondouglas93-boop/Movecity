{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:driver": "vite --mode driver --open /driver.html",
    "dev:passenger": "vite --mode passenger --open /passenger.html",
    "build": "vite build",
    "build:driver": "vite build --mode driver",
    "build:passenger": "node scripts/build-passenger.mjs",
    "preview": "vite preview",
    "preview:driver": "vite preview --mode driver",
    "preview:passenger": "vite preview --mode passenger",
    "cap:sync": "npm run build:driver && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:release": "node scripts/cap-release.mjs",
    "aab:driver": "node scripts/build-play-bundle.mjs driver",
    "aab:passenger": "node scripts/build-play-bundle.mjs passenger",
    "cap:add:passenger": "npm run build:passenger && node scripts/cap-passenger.mjs add android",
    "cap:sync:passenger": "npm run build:passenger && node scripts/cap-passenger.mjs sync android",
    "cap:open:passenger": "node scripts/cap-passenger.mjs open android",
    "apk:passenger:debug": "npm run cap:sync:passenger && node scripts/gradle-passenger.mjs assembleDebug",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/network": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@capawesome-team/capacitor-android-foreground-service": "^6.2.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@gsap/react": "^2.1.1",
    "@hookform/resolvers": "^5.5.7",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.16.0",
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^6.28.0",
    "remixicon": "^4.5.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
